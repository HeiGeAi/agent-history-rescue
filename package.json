{
  "name": "agent-history-rescue",
  "version": "3.0.0",
  "description": "Recover coding-agent conversations that vanished after switching accounts, providers, reinstalling, or upgrading, or rebuild them from an exported data archive (e.g. after a ban). Supports Claude Code and Codex. Backup-first, never deletes, one-command rollback.",
  "bin": {
    "agent-history-rescue": "bin/agent-history-rescue.js"
  },
  "scripts": {
    "start": "node bin/agent-history-rescue.js",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "openai-codex",
    "history",
    "sessions",
    "recover",
    "migrate",
    "backup",
    "cli",
    "data-export",
    "import",
    "account-ban",
    "conversation-export"
  ],
  "author": "HeiGeAi (Blake Xu) (https://github.com/HeiGeAi)",
  "license": "MIT",
  "homepage": "https://github.com/HeiGeAi/agent-history-rescue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeiGeAi/agent-history-rescue.git"
  },
  "bugs": {
    "url": "https://github.com/HeiGeAi/agent-history-rescue/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
